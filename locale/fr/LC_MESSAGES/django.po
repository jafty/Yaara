msgid "<strong>%(free)s Mesures</strong> libres ; <strong>%(reserved)s</strong> réservées.<br>Prélèvement en préparation : <strong>%(tax)s Mesures</strong>, encore indisponibles."
msgstr "<strong>%(free)s Mesures</strong> libres ; <strong>%(reserved)s</strong> réservées.<br>Prélèvement en préparation : <strong>%(tax)s Mesures</strong>, encore indisponibles."

msgid "Les dépenses sont réparties automatiquement entre les greniers de votre maison. Les réserves restent locales pour les pillages et le stockage."
msgstr "Les dépenses sont réparties automatiquement entre les greniers de votre maison. Les réserves restent locales pour les pillages et le stockage."

msgid "Forge de niveau <strong>%(level)s</strong> : <strong>%(equipment)s</strong> pour les Fidèles de cette cité."
msgstr "Forge de niveau <strong>%(level)s</strong> : <strong>%(equipment)s</strong> pour les Fidèles de cette cité."

msgid "Le rang tient déjà compte du départage par population. Deux maisons ayant autant de cités peuvent donc occuper des rangs différents ; un même rang indique une égalité complète."
msgstr "Le rang tient déjà compte du départage par population. Deux maisons ayant autant de cités peuvent donc occuper des rangs différents ; un même rang indique une égalité complète."

