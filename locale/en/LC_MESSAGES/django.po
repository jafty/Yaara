msgstr "Pause the reign"

#: simulation/templates/simulation/shared_operator.html
msgid "Rejoindre votre maison"
msgstr "Join your house"

#: simulation/templates/simulation/shared_operator.html
msgid "Arrêter ce règne"
msgstr "Stop this reign"

#: simulation/templates/simulation/shared_operator.html
msgid "Cet arrêt ferme les invitations et le calendrier sans désigner de vainqueur."
msgstr "Stopping closes the invitations and calendar without declaring a winner."

#: simulation/templates/simulation/shared_operator.html
msgid "Confirmer l’arrêt du règne"
msgstr "Confirm stopping the reign"

#: simulation/templates/simulation/shared_operator.html
msgid "Tous les règnes partagés"
msgstr "All shared reigns"

#: simulation/templates/simulation/shared_manage.html
msgid "LES RÈGNES PARTAGÉS"
msgstr "SHARED REIGNS"

#: simulation/templates/simulation/shared_manage.html
msgid "Réunir trois maisons"
msgstr "Gather three houses"

#: simulation/templates/simulation/shared_manage.html
msgid "Préparez un règne, transmettez un lien privé à chaque joueur, puis donnez le départ quand les trois maisons sont présentes."
msgstr "Prepare a reign, send each player a private link, then start when all three houses have joined."

#: simulation/templates/simulation/shared_manage.html
msgid "Ouvrir un règne partagé"
msgstr "Open a shared reign"

#: simulation/templates/simulation/shared_manage.html
msgid "À dix minutes par lune, un règne de 120 lunes représente vingt heures de calendrier actif. Prévoyez des plages communes et suspendez le règne entre les séances."
msgstr "At ten minutes per Moon, a reign of 120 Moons takes twenty hours of active play time. Agree on playing times and pause the reign between sessions."

#: simulation/templates/simulation/shared_manage.html
msgid "Préparer les invitations"
msgstr "Prepare the invitations"

#: simulation/templates/simulation/shared_manage.html
msgid "Les règnes préparés"
msgstr "Prepared reigns"

#: simulation/templates/simulation/shared_manage.html
msgid "En attente du départ"
msgstr "Waiting to start"

#: simulation/templates/simulation/shared_manage.html
msgid "Arrêté"
msgstr "Stopped"

#: simulation/templates/simulation/shared_manage.html
msgid "Suspendu"
msgstr "Paused"

#: simulation/templates/simulation/shared_manage.html
msgid "Aucun règne partagé n’a encore été préparé."
msgstr "No shared reign has been prepared yet."

