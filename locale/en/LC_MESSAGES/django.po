msgstr "{value0} The survivors return towards their origins; they will rejoin those present on the announced date. "

msgid "{value0} change de souverain"
msgstr "{value0} changes ruler"

msgid "{value0} à {value1}"
msgstr "{value0} at {value1}"

msgid "À <strong>%(v0)s</strong> : <em>%(v1)s</em>. Achèvement à la <strong>lune %(v2)s</strong>."
