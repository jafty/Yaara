#: simulation/guest_views.py
msgid "Autorisez les cookies de ce site, puis revenez à l’accueil pour commencer."
msgstr "Allow cookies for this site, then return to the home page to begin."

msgid "Actualiser les places"
msgstr "Refresh available spots"

msgid "Adresse confirmée."
msgstr "Address confirmed."

msgid "Adresse confirmée. Vous recevrez uniquement les nouvelles choisies."
msgstr "Address confirmed. You will receive only the updates you selected."

msgid "Attendez cinq minutes avant de demander un nouvel e-mail de confirmation."
msgstr "Wait five minutes before requesting another confirmation email."

msgid "Bilan annuel et récoltes"
msgstr "Annual accounts and harvests"

msgid "CHOISISSEZ VOTRE MAISON"
msgstr "CHOOSE YOUR HOUSE"

msgid "Ce règne n’accepte plus de nouveaux joueurs."
msgstr "This reign is closed to new players."

msgid "Ce règne n’accepte plus de nouveaux joueurs. Utilisez votre lien privé pour retrouver une maison déjà choisie."
msgstr "This reign is closed to new players. Use your private link to return to a house you have already chosen."

msgid "Cette place n’est plus disponible. Choisissez une autre maison."
msgstr "This spot is no longer available. Choose another house."

msgid "Cette place vient d’être choisie. Sélectionnez un autre territoire ; votre nom est conservé."
msgstr "Someone just chose this spot. Select another territory; your house name has been kept."

msgid "Choisir une place"
msgstr "Choose a spot"

msgid "Choisissez les nouvelles de cette maison. Les raids sont désactivés par défaut. Aucun e-mail ne part avant confirmation de votre adresse."
msgstr "Choose updates for this house. Raid emails are off by default. No updates are sent until you confirm your address."

msgid "Choisissez un nom de maison de 1 à 80 caractères, sur une ligne."
msgstr "Choose a house name of 1 to 80 characters, on one line."

msgid "Choisissez vos trois cités de départ et donnez un nom à votre maison. Aucune inscription n’est nécessaire."
msgstr "Choose your three starting cities and name your house. No account is required."

msgid "Confirmation en attente. Vérifiez votre messagerie ; vous pourrez renouveler la demande après une heure."
msgstr "Confirmation pending. Check your inbox; you can request another confirmation after one hour."

msgid "Confirmer mon adresse"
msgstr "Confirm my address"

msgid "Confirmez les notifications de Yaara"
msgstr "Confirm your Yaara notifications"

msgid "Confirmez votre adresse sous 48 heures pour recevoir les nouvelles choisies."
msgstr "Confirm your address within 48 hours to receive the updates you selected."

msgid "Conquêtes et résultats de capture"
msgstr "Conquests and capture results"

msgid "Conservez ce lien pour retrouver votre maison sur un autre appareil. Il donne accès à votre place : gardez-le secret."
msgstr "Keep this link to return to your house on another device. It grants access to your spot: keep it private."

msgid "Des nouvelles de votre maison dans Yaara"
msgstr "Updates from your house in Yaara"

msgid "Départ du règne"
msgstr "Reign start"

