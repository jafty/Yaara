# Export these in your shell (or set them in Railway). Django does not load .env automatically.
DEBUG=1
# Replace the local placeholders; never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://yaara:replace-local-password@127.0.0.1:5432/yaara
POSTGRES_PASSWORD=replace-local-password
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
SIGNUP_ENABLED=1
WEB_CONCURRENCY=2
